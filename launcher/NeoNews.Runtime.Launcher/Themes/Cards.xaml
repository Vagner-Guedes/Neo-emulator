<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ReferenceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="30" />
    </Style>
    <Style x:Key="InnerReferenceCardStyle" TargetType="Border" BasedOn="{StaticResource ReferenceCardStyle}">
        <Setter Property="Background" Value="{StaticResource InnerCardBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource ReferenceCardStyle}">
        <Setter Property="Background" Value="#0A1C2A" />
        <Setter Property="BorderBrush" Value="#15506B" />
        <Setter Property="Padding" Value="44" />
    </Style>
    <Style x:Key="StatusCardStyle" TargetType="Border" BasedOn="{StaticResource ReferenceCardStyle}">
        <Setter Property="Background" Value="#0B1C2A" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
