<UserControl x:Class="NeoNews.Runtime.Launcher.Views.NeoNewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="56,59,62,0">
            <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="561" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel><TextBlock Text="NeoNews" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Informações do aplicativo" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" /></StackPanel><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="24" Height="24" Fill="{Binding SystemStatusBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusBrush}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource ReferenceCardStyle}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="112" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27*" /><ColumnDefinition Width="42.6*" /><ColumnDefinition Width="30.4*" /></Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Margin="10,28,34,26">
                        <Ellipse Width="260" Height="145" Stroke="#0B5775" StrokeThickness="1" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-20" /></Ellipse.RenderTransform></Ellipse>
                        <Ellipse Width="210" Height="120" Stroke="#0B3850" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,67,0,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="20" /></Ellipse.RenderTransform></Ellipse>
                        <Border Width="148" Height="148" CornerRadius="29" Background="#0A2B3E" BorderBrush="#087EA9" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="8" /></Border.RenderTransform><TextBlock Text="N" Foreground="#39D7F7" FontSize="88" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-8" /></TextBlock.RenderTransform></TextBlock></Border>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,53,26,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"><Ellipse Width="30" Height="30" Fill="{Binding NeoNewsStatusBrush}" VerticalAlignment="Center" Margin="0,0,16,0" /><StackPanel><TextBlock Text="{Binding NeoNewsStatusHeading}" Foreground="{Binding NeoNewsStatusBrush}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding NeoNewsStatusDescription}" Style="{StaticResource BodyStyle}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></StackPanel>
                        <Grid Grid.Row="1" Margin="0,52,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Grid.Column="0" Data="{StaticResource IconTag}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="25" Height="25" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Versão" Style="{StaticResource BodyStyle}" /><TextBlock Grid.Column="2" Text="{Binding NeoNewsVersionDisplay}" Foreground="{StaticResource CyanBrush}" Style="{StaticResource BodyStyle}" /></Grid>
                        <Grid Grid.Row="2" Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" /><Path Grid.Column="0" Data="{StaticResource IconCube}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="25" Height="25" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Pacote" Style="{StaticResource BodyStyle}" Margin="0,15,0,0" /><TextBlock Grid.Column="2" Text="{Binding NeoNewsPackageDisplay}" Foreground="{StaticResource CyanBrush}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,15,0,0" /></Grid>
                        <Grid Grid.Row="3" Margin="0,38,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" /><Path Grid.Column="0" Data="{StaticResource IconHash}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="25" Height="25" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Código" Style="{StaticResource BodyStyle}" Margin="0,15,0,0" /><TextBlock Grid.Column="2" Text="{Binding NeoNewsCodeDisplay}" Foreground="{StaticResource CyanBrush}" Style="{StaticResource BodyStyle}" Margin="0,15,0,0" /></Grid>
                        <Grid Grid.Row="4" Margin="0,32,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" /><Path Grid.Column="0" Data="{StaticResource IconChip}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="25" Height="25" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Arquitetura" Style="{StaticResource BodyStyle}" Margin="0,15,0,0" /><TextBlock Grid.Column="2" Text="{Binding NeoNewsArchitectureDisplay}" Foreground="{StaticResource CyanBrush}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,15,0,0" /></Grid>
                    </Grid>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,34,44,25" Padding="32,0,0,0">
                        <StackPanel VerticalAlignment="Top" Margin="0,96,0,0">
                            <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding OpenCommand}" Height="71" Margin="0,0,0,26"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,14,0" /><TextBlock Text="Abrir NeoNews" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource OutlineActionButton}" Command="{Binding RestartNeoNewsCommand}" Height="71" Margin="0,0,0,26"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22" Margin="0,0,14,0" /><TextBlock Text="Reiniciar aplicativo" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource OutlineActionButton}" Command="{Binding InstallCommand}" Height="71"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDownload}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22" Margin="0,0,14,0" /><TextBlock Text="Atualizar aplicativo" VerticalAlignment="Center" /></StackPanel></Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="198,0,180,0">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal"><Path Data="{StaticResource IconClock}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="26" Height="26" Margin="0,0,18,0" /><StackPanel><TextBlock Text="Última atualização" Style="{StaticResource BodyStyle}" FontSize="14" /><TextBlock Text="{Binding NeoNewsLastUpdate}" Foreground="{StaticResource CyanBrush}" FontSize="16" Margin="0,5,0,0" /></StackPanel></StackPanel><Border Grid.Column="1" Background="{StaticResource BorderBrush}" /><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="48,0,0,0"><Path Data="{StaticResource IconShield}" Stroke="{Binding NeoNewsStatusBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="26" Height="26" Margin="0,0,18,0" /><StackPanel><TextBlock Text="Status" Style="{StaticResource BodyStyle}" FontSize="14" /><TextBlock Text="{Binding NeoNewsStatus}" Foreground="{Binding NeoNewsStatusBrush}" FontSize="16" Margin="0,5,0,0" /></StackPanel></StackPanel></Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>




