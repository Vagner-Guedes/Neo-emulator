<UserControl x:Class="NeoNews.Runtime.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="69,36,68,0">
            <Grid.RowDefinitions><RowDefinition Height="115" /><RowDefinition Height="561" /><RowDefinition Height="94" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel><TextBlock Text="Configura&#231;&#245;es" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Ajustes do sistema" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" /></StackPanel><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="24" Height="24" Fill="{Binding SystemStatusBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusBrush}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border></Grid>
            <StackPanel Grid.Row="1" Margin="0">
                <Button Style="{StaticResource SettingsRowButton}" HorizontalContentAlignment="Stretch" Height="103" Padding="38,0,52,0" Margin="0,0,0,10" Click="SettingsRow_Click" Tag="Geral"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" Width="66" Height="66" CornerRadius="33" Background="#0B3041" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconGear}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Geral" Style="{StaticResource CardTitleStyle}" FontSize="20" /><TextBlock Text="Inicializa&#231;&#227;o, idioma e comportamento geral" Style="{StaticResource BodyStyle}" Margin="0,7,0,0" /></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Button>
                <Button Style="{StaticResource SettingsRowButton}" HorizontalContentAlignment="Stretch" Height="103" Padding="38,0,52,0" Margin="0,0,0,10" Click="SettingsRow_Click" Tag="Tela"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" Width="66" Height="66" CornerRadius="33" Background="#0B3041" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconMonitor}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tela" Style="{StaticResource CardTitleStyle}" FontSize="20" /><TextBlock Text="Resolu&#231;&#227;o, tela cheia e modo kiosk" Style="{StaticResource BodyStyle}" Margin="0,7,0,0" /></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Button>
                <Button Style="{StaticResource SettingsRowButton}" HorizontalContentAlignment="Stretch" Height="103" Padding="38,0,52,0" Margin="0,0,0,10" Click="SettingsRow_Click" Tag="Desempenho"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" Width="66" Height="66" CornerRadius="33" Background="#0B3041" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconWave}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Desempenho" Style="{StaticResource CardTitleStyle}" FontSize="20" /><TextBlock Text="Mem&#243;ria, processadores e GPU" Style="{StaticResource BodyStyle}" Margin="0,7,0,0" /></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Button>
                <Button Style="{StaticResource SettingsRowButton}" HorizontalContentAlignment="Stretch" Height="103" Padding="38,0,52,0" Margin="0,0,0,10" Click="SettingsRow_Click" Tag="Avan&#231;ado"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" Width="66" Height="66" CornerRadius="33" Background="#0B3041" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconCode}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Avan&#231;ado" Style="{StaticResource CardTitleStyle}" FontSize="20" /><TextBlock Text="Android, ADB, WebView e caminhos do sistema" Style="{StaticResource BodyStyle}" Margin="0,7,0,0" /></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Button>
                <Button Style="{StaticResource SettingsRowButton}" HorizontalContentAlignment="Stretch" Height="103" Padding="38,0,52,0"  Click="SettingsRow_Click" Tag="Seguran&#231;a"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" Width="66" Height="66" CornerRadius="33" Background="#0B3041" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconShield}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Seguran&#231;a" Style="{StaticResource CardTitleStyle}" FontSize="20" /><TextBlock Text="Permiss&#245;es, logs e prote&#231;&#227;o operacional" Style="{StaticResource BodyStyle}" Margin="0,7,0,0" /></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Button>
            </StackPanel>
            <Button Grid.Row="2" Content="Restaurar padr&#245;es" Style="{StaticResource OutlineActionButton}" Width="326" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ResetDefaultsCommand}"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource BrightBlueBrush}" StrokeThickness="1.7" Stretch="Uniform" Width="23" Height="23" Margin="0,0,15,0" /><TextBlock Text="Restaurar padr&#245;es" Foreground="{StaticResource BrightBlueBrush}" FontSize="17" VerticalAlignment="Center" /></StackPanel></DataTemplate></Button.ContentTemplate></Button>
        </Grid>
    </ScrollViewer>
</UserControl>






