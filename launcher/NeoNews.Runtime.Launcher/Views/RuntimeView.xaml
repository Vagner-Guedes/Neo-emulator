<UserControl x:Class="NeoNews.Runtime.Launcher.Views.RuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="58,59,64,0">
            <Grid.RowDefinitions><RowDefinition Height="135" /><RowDefinition Height="548" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel><TextBlock Text="Runtime" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Status dos componentes do sistema" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" /></StackPanel><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="24" Height="24" Fill="{Binding SystemStatusBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusBrush}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border></Grid>
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="258" /><RowDefinition Height="30" /><RowDefinition Height="260" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ReferenceCardStyle}" Margin="0,0,19,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#12352C" BorderBrush="#1C6C49" BorderThickness="1"><Path Data="{StaticResource IconAndroid}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="Android" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding AndroidStatus}" Foreground="{Binding AndroidStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="Android 7.1.1" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="API 25" Style="{StaticResource BodyStyle}" Margin="0,19,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ReferenceCardStyle}" Margin="10,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#0D3147" BorderBrush="#087EA9" BorderThickness="1"><Path Data="{StaticResource IconGlobe}" Stroke="#39C9F2" StrokeThickness="1.8" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="WebView" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding WebViewStatus}" Foreground="{Binding WebViewStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="{Binding WebViewVersionLabel}" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="Provider: Android System WebView" Style="{StaticResource BodyStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,19,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ReferenceCardStyle}" Margin="19,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#2B1B42" BorderBrush="#6A42A8" BorderThickness="1"><Path Data="{StaticResource IconWave}" Stroke="{StaticResource PurpleBrush}" StrokeThickness="2" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="Voz (RHVoice)" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding VoiceStatus}" Foreground="{Binding VoiceStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="{Binding VoiceLocaleLabel}" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="Engine: RHVoice" Style="{StaticResource BodyStyle}" Margin="0,19,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ReferenceCardStyle}" Margin="0,0,19,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#0D3540" BorderBrush="#00A9C9" BorderThickness="1"><Path Data="{StaticResource IconShield}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="Watchdog" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding WatchdogStatus}" Foreground="{Binding WatchdogStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="Supervis&#227;o ativa" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="Rein&#237;cio autom&#225;tico" Style="{StaticResource BodyStyle}" Margin="0,19,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ReferenceCardStyle}" Margin="10,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#0C2B3A" BorderBrush="#0A7EA8" BorderThickness="1"><Path Data="{StaticResource IconMonitor}" Stroke="#63E6FF" StrokeThickness="1.8" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="Kiosk" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding KioskStatus}" Foreground="{Binding KioskStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="Modo quiosque" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="Tela cheia" Style="{StaticResource BodyStyle}" Margin="0,19,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ReferenceCardStyle}" Margin="19,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border VerticalAlignment="Top" Margin="0,22,0,0" Width="90" Height="90" CornerRadius="45" Background="#102C4B" BorderBrush="#185D9B" BorderThickness="1"><Path Data="{StaticResource IconPower}" Stroke="#5F9CFF" StrokeThickness="1.8" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,18,0,0"><TextBlock Text="Inicializa&#231;&#227;o" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{Binding StartupStatus}" Foreground="{Binding StartupStatusBrush}" FontSize="18" Margin="0,15,0,0" /><TextBlock Text="Inicia com o Windows" Style="{StaticResource BodyStyle}" Margin="0,26,0,0" /><TextBlock Text="Autostart configurado" Style="{StaticResource BodyStyle}" Margin="0,19,0,0" /></StackPanel></Grid></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>







