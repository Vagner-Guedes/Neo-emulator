<UserControl x:Class="NeoNews.Runtime.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="56,59,62,0">
            <Grid.RowDefinitions><RowDefinition Height="468" /><RowDefinition Height="32" /><RowDefinition Height="170" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource HeroCardStyle}" Padding="44,36,44,36">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.56*" /><ColumnDefinition Width="0.44*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="26,16,0,0">
                        <TextBlock Text="BEM-VINDO AO" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="NeoNews Runtime" Foreground="{StaticResource PrimaryTextBrush}" FontSize="46" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock Text="Plataforma completa para gerenciar e operar o sistema NeoNews com estabilidade e segurança." Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" MaxWidth="485" Margin="0,17,0,0" LineHeight="29" />
                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding StartCommand}" Width="265" Height="78" HorizontalAlignment="Left" Margin="0,57,0,0">
                            <StackPanel Orientation="Horizontal"><Border Width="43" Height="43" CornerRadius="22" BorderBrush="#86EEFF" BorderThickness="1" Background="#24B8E2" Margin="0,0,15,0"><Path Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="19" Height="19" /></Border><TextBlock Text="Iniciar sistema" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,0,0,0">
                        <Ellipse Width="370" Height="205" Stroke="#087A9F" StrokeThickness="1" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-13" /></Ellipse.RenderTransform></Ellipse>
                        <Ellipse Width="310" Height="160" Stroke="#0B5472" StrokeThickness="1" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,65,0,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="17" /></Ellipse.RenderTransform></Ellipse>
                        <Border Width="154" Height="154" CornerRadius="30" Background="#0A2C3F" BorderBrush="#087B9F" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="8" /></Border.RenderTransform><TextBlock Text="N" Foreground="#37D8F6" FontSize="92" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-8" /></TextBlock.RenderTransform></TextBlock></Border>
                        <Border Style="{StaticResource StatusCardStyle}" Width="420" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Grid.Column="0" Width="36" Height="36" Fill="#36576D" Stroke="{Binding SystemStatusBrush}" StrokeThickness="2" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding HomeHeroTitle}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{Binding HomeHeroDescription}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ReferenceCardStyle}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="88" Height="88" CornerRadius="44" Background="#12352C" BorderBrush="#1C6C49" BorderThickness="1"><Path Data="{StaticResource IconAndroid}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="45" Height="45" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,3,0,0"><TextBlock Text="ANDROID" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding AndroidStatus}" Foreground="{Binding AndroidStatusBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="{Binding HomeAndroidDetail}" Style="{StaticResource BodyStyle}" FontSize="14" Margin="0,7,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource ReferenceCardStyle}" Margin="5,0,5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="88" Height="88" CornerRadius="16" Background="#0D354D" BorderBrush="#087EA9" BorderThickness="1"><TextBlock Text="N" Foreground="{StaticResource CyanBrush}" FontSize="52" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,3,0,0"><TextBlock Text="NEONEWS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding NeoNewsStatus}" Foreground="{Binding NeoNewsStatusBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="{Binding HomeNeoNewsDetail}" Style="{StaticResource BodyStyle}" FontSize="14" Margin="0,7,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource ReferenceCardStyle}" Margin="10,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="88" Height="88" CornerRadius="44" Background="#251C3D" BorderBrush="#503D81" BorderThickness="1"><Path Data="{StaticResource IconGlobe}" Stroke="{StaticResource PurpleBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="45" Height="45" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="20,3,0,0"><TextBlock Text="INTERNET" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding NetworkStatus}" Foreground="{Binding NetworkStatusBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="Acesso ao host" Style="{StaticResource BodyStyle}" FontSize="14" Margin="0,7,0,0" /></StackPanel></Grid></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
