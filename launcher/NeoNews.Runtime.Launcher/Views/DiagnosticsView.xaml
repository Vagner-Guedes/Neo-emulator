<UserControl x:Class="NeoNews.Runtime.Launcher.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="54,44,59,0">
            <Grid.RowDefinitions><RowDefinition Height="116" /><RowDefinition Height="614" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel><TextBlock Text="Diagnóstico" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Verificação e ferramentas do sistema" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" /></StackPanel><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="24" Height="24" Fill="{Binding SystemStatusBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusBrush}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border></Grid>
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.46*" /><ColumnDefinition Width="0.54*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ReferenceCardStyle}" Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"><Path Data="{StaticResource IconMonitor}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="28" Height="28" Margin="0,0,17,0" /><TextBlock Text="Status do sistema" Style="{StaticResource CardTitleStyle}" FontSize="22" /></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,11,0,0">
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding AndroidStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding AndroidStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="Android" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding AndroidStatus}" Foreground="{Binding AndroidStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding AdbStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding AdbStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="ADB" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding AdbStatus}" Foreground="{Binding AdbStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding NeoNewsStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding NeoNewsStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="NeoNews" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding NeoNewsStatus}" Foreground="{Binding NeoNewsStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding WebViewStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding WebViewStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="WebView" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding WebViewStatus}" Foreground="{Binding WebViewStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding VoiceStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding VoiceStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="Voz (RHVoice)" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding VoiceStatus}" Foreground="{Binding VoiceStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding NetworkStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding NetworkStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="Rede" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding NetworkStatus}" Foreground="{Binding NetworkStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding WatchdogStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding WatchdogStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="Watchdog" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding WatchdogStatus}" Foreground="{Binding WatchdogStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <Grid Height="61"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding StorageStatusBrush}" BorderThickness="1.5"><Path Data="{StaticResource IconCheck}" Stroke="{Binding StorageStatusBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="Armazenamento" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" /><Line Grid.Column="2" X1="0" X2="1" Y1="0" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Center" Margin="14,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding StorageStatus}" Foreground="{Binding StorageStatusBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="15,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="314" /><RowDefinition Height="17" /><RowDefinition Height="283" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ReferenceCardStyle}" Padding="37,25">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Grid.Row="0" Orientation="Horizontal"><Path Data="{StaticResource IconBolt}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="28" Height="28" Margin="0,0,17,0" /><TextBlock Text="Ações rápidas" Style="{StaticResource CardTitleStyle}" FontSize="22" /></StackPanel><Grid Grid.Row="1" Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryActionButton}" Command="{Binding DiagnosticsCommand}" Height="190" VerticalAlignment="Top" Margin="0,0,10,0"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#25B9E3" BorderBrush="#8AEEFF" BorderThickness="1" HorizontalAlignment="Center"><Path Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Executar diagnóstico" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0" /><TextBlock Text="Verifique o status de todos os componentes" Style="{StaticResource BodyStyle}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel></Button><Button Grid.Column="1" Style="{StaticResource PrimaryActionButton}" Command="{Binding OpenLogsCommand}" Height="190" VerticalAlignment="Top" Margin="10,0,0,0"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#25B9E3" BorderBrush="#8AEEFF" BorderThickness="1" HorizontalAlignment="Center"><Path Data="{StaticResource IconFile}" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.7" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Ver logs completos" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0" /><TextBlock Text="Abra o visualizador de logs detalhados" Style="{StaticResource BodyStyle}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel></Button></Grid></Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource ReferenceCardStyle}" Padding="37,25"><Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Grid.Row="0" Orientation="Horizontal"><Path Data="{StaticResource IconFile}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="28" Height="28" Margin="0,0,17,0" /><TextBlock Text="Logs recentes" Style="{StaticResource CardTitleStyle}" FontSize="22" /></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding RecentLogLines}" Margin="0,17,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="46"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource BrightBlueBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource BrightBlueBrush}" FontSize="15" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

