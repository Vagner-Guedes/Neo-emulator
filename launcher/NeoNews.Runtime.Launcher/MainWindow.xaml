<Window x:Class="NeoNews.Runtime.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoNews Runtime"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#10151B"
        Foreground="#F3F6F8">
    <Grid Margin="56">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="NEONEWS RUNTIME" FontSize="18" FontWeight="SemiBold" Foreground="#7DD3FC" />
            <TextBlock Text="Digital signage control" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#1C2630" CornerRadius="10" Padding="18" Margin="0,28,0,24">
            <StackPanel>
                <TextBlock Text="Estado" FontSize="14" Foreground="#9FB0BE" />
                <TextBlock x:Name="StatusText" Text="Inicializando..." FontSize="22" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <Button Content="Iniciar NeoNews" Click="StartNeoNews_Click" Height="64" Margin="0,0,0,14" FontSize="20" />
                <Button Content="Aplicar kiosk" Click="ApplyKiosk_Click" Height="64" Margin="0,0,0,14" FontSize="20" />
                <Button Content="Diagnóstico do runtime" Click="Diagnostics_Click" Height="64" Margin="0,0,0,14" FontSize="20" />
                <Button Content="Sair" Click="Exit_Click" Height="52" FontSize="18" />
            </StackPanel>

            <Border Grid.Column="1" Background="#0B1015" CornerRadius="10" Padding="18">
                <TextBox x:Name="OutputText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="#B6C6D3"
                         BorderThickness="0"
                         FontFamily="Cascadia Mono"
                         FontSize="14" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Escopo: controle local do runtime • artefatos proprietários permanecem externos" Foreground="#718391" Margin="0,24,0,0" />
    </Grid>
</Window>
