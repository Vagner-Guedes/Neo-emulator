<Window x:Class="NeoNews.Runtime.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoNews Runtime"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1017"
        Foreground="#E6EDF3"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="Background" Value="#182431" />
            <Setter Property="BorderBrush" Value="#2B3B4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#223447" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2A4B60" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0891B2" />
            <Setter Property="BorderBrush" Value="#22D3EE" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#111B26" />
            <Setter Property="BorderBrush" Value="#1D2C3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8193A4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="218" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" Background="#0E7490" CornerRadius="12" VerticalAlignment="Center">
                    <TextBlock Text="N" FontSize="28" FontWeight="Bold" Foreground="#CFFAFE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NEONEWS RUNTIME" Foreground="#67E8F9" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Console de operação" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ESTADO DO RUNTIME" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding StateLabel}" Foreground="#A5F3FC" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="CONTROLES" Style="{StaticResource Muted}" Margin="0,0,0,14" />
                    <Button Content="Iniciar NeoNews" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                    <Button Content="Parar Android" Command="{Binding StopCommand}" />
                    <Button Content="Reiniciar Android" Command="{Binding RestartCommand}" />
                    <Button Content="Abrir NeoNews" Command="{Binding OpenCommand}" />
                    <Button Content="Instalar / atualizar APK" Command="{Binding InstallCommand}" />
                    <Separator Margin="0,5,0,13" Background="#263746" />
                    <Button Content="Ativar kiosk" Command="{Binding KioskCommand}" />
                    <Button Content="Sair do kiosk" Command="{Binding ExitKioskCommand}" />
                    <Button Content="Diagnóstico" Command="{Binding DiagnosticsCommand}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Configuração" Click="Settings_Click" Width="108" Margin="0,0,7,0" />
                        <Button Content="Logs" Command="{Binding OpenLogsCommand}" Width="108" Margin="0" />
                    </StackPanel>
                    <Button Content="Encerrar runtime" Command="{Binding ExitCommand}" Margin="0,15,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Visão geral" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  Atualização automática" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#16222E" CornerRadius="8" Margin="0,0,10,10" Padding="13">
                            <StackPanel><TextBlock Text="ANDROID" Style="{StaticResource Muted}" /><TextBlock Text="{Binding AndroidStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#A5F3FC" /><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="ADB: " Style="{StaticResource Muted}" /><TextBlock Text="{Binding AdbStatus}" Style="{StaticResource Muted}" /></StackPanel></StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#16222E" CornerRadius="8" Margin="0,0,10,10" Padding="13">
                            <StackPanel><TextBlock Text="NEONEWS" Style="{StaticResource Muted}" /><TextBlock Text="{Binding NeoNewsStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#A5F3FC" /><TextBlock Text="Pacote configurado" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#16222E" CornerRadius="8" Margin="0,0,0,10" Padding="13">
                            <StackPanel><TextBlock Text="WEBVIEW" Style="{StaticResource Muted}" /><TextBlock Text="{Binding WebViewStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#FDE68A" /><TextBlock Text="Provider Android" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#16222E" CornerRadius="8" Margin="0,0,10,0" Padding="13">
                            <StackPanel><TextBlock Text="VOZ" Style="{StaticResource Muted}" /><TextBlock Text="{Binding VoiceStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#FDE68A" /><TextBlock Text="Locale pt-BR" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#16222E" CornerRadius="8" Margin="0,0,10,0" Padding="13">
                            <StackPanel><TextBlock Text="WATCHDOG" Style="{StaticResource Muted}" /><TextBlock Text="{Binding WatchdogStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#A5F3FC" /><TextBlock Text="Supervisão de activity" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#16222E" CornerRadius="8" Margin="0" Padding="13">
                            <StackPanel><TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource Muted}" /><TextBlock Text="{Binding StartupStatus}" FontSize="16" Margin="0,6,0,0" Foreground="#A5F3FC" /><TextBlock Text="Atalho --autostart" Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="Atividade e logs" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Grid.Row="1" Height="6" Margin="0,11,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Background="#1E2D3B" Foreground="#22D3EE" />
                <TextBox Grid.Row="2" Text="{Binding Logs, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0B1118" Foreground="#9FB3C4" BorderThickness="0" Padding="10" FontFamily="Cascadia Mono" FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,9,2,0">
            <TextBlock Text="Ctrl + Alt + Shift + F12 · sair do kiosk" Style="{StaticResource Muted}" />
            <TextBlock Text="{Binding LastError}" Foreground="#FDA4AF" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
