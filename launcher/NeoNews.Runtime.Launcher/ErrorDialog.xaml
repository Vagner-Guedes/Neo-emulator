<Window x:Class="NeoNews.Runtime.Launcher.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoNews Runtime"
        Width="650"
        Height="410"
        MinWidth="500"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#101923"
        Foreground="#E6EDF3">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="18" Background="#7F1D1D" Margin="0,0,12,0"><TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="#FECACA" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="A operação não foi concluída" Foreground="#FDA4AF" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="MessageText" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
        </StackPanel>
        <Expander Grid.Row="1" Header="Detalhes técnicos" Foreground="#A5F3FC" Margin="0,25,0,0">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#0B1118" Foreground="#AFC1CF" BorderThickness="0" Padding="10" FontFamily="Cascadia Mono" FontSize="11" />
        </Expander>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Copiar detalhes" Click="Copy_Click" Background="#182431" Foreground="#E6EDF3" BorderBrush="#314454" Padding="12,8" Margin="0,0,8,0" />
            <Button Content="Fechar" Click="Close_Click" Background="#0891B2" Foreground="#E6EDF3" BorderBrush="#22D3EE" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
