<Window x:Class="NeoNews.Runtime.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração do runtime"
        Width="560"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101923"
        Foreground="#E6EDF3">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D7E2EA" /></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#182431" /><Setter Property="Foreground" Value="#E6EDF3" /><Setter Property="BorderBrush" Value="#314454" /><Setter Property="Padding" Value="8,6" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#182431" /><Setter Property="Foreground" Value="#E6EDF3" /><Setter Property="BorderBrush" Value="#314454" /><Setter Property="Padding" Value="7,5" /></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#182431" /><Setter Property="Foreground" Value="#E6EDF3" /><Setter Property="BorderBrush" Value="#314454" /><Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="CONFIGURAÇÃO" Foreground="#67E8F9" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="Preferências de operação" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="StartWithWindows" Content="Iniciar com o Windows" FontSize="14" Margin="0,0,0,13" />
                <CheckBox x:Name="AutoKiosk" Content="Ativar kiosk ao abrir o NeoNews" FontSize="14" Margin="0,0,0,13" />
                <CheckBox x:Name="Watchdog" Content="Ativar watchdog e relançar activity perdida" FontSize="14" Margin="0,0,0,20" />
                <TextBlock Text="Tela do emulador" Foreground="#8193A4" FontSize="12" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Largura" FontSize="12" /><TextBox x:Name="WidthInput" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Altura" FontSize="12" /><TextBox x:Name="HeightInput" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Densidade" FontSize="12" /><TextBox x:Name="DensityInput" Margin="0,5,0,0" /></StackPanel>
                </Grid>
                <TextBlock Text="Renderização GPU" FontSize="12" />
                <ComboBox x:Name="Gpu" Margin="0,5,0,17" SelectedIndex="0">
                    <ComboBoxItem Content="swiftshader" />
                    <ComboBoxItem Content="host" />
                    <ComboBoxItem Content="auto" />
                </ComboBox>
                <Border Background="#16222E" BorderBrush="#263746" BorderThickness="1" Padding="12" CornerRadius="7">
                    <TextBlock Text="As alterações de tela são aplicadas no próximo boot do Android. O startup do Windows usa somente NeoNewsRuntime.exe --autostart." TextWrapping="Wrap" Foreground="#9FB3C4" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" />
            <Button Content="Salvar" Click="Save_Click" Background="#0891B2" BorderBrush="#22D3EE" FontWeight="SemiBold" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
