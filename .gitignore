# Entradas proprietárias fornecidas externamente; não distribuir no repositório.
/app.apk
/packages/neonews/*.apk
/packages/webview/*
/packages/tts/*
/packages/nativebridge/*
/NeoNews.apk
**/NeoNews.apk

# Runtime e estado gerados localmente.
/runtime/
/logs/*
!/logs/.gitkeep
/reports/*
!/reports/.gitkeep
*.tmp
*.bak

# Artefatos de build e arquivos locais do .NET/WPF.
/tools/tts-probe/build/
/tools/webview-probe/build/
/tools/media-probe/build/
[Bb]in/
[Oo]bj/
/dist/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Segredos e configurações específicas da máquina.
.env
.env.*
!.env.example
*.pfx
*.snk
