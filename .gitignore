# Artefatos de build e arquivos locais do .NET/WPF.
[Bb]in/
[Oo]bj/
/dist/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Segredos e configurações específicas da máquina.
.env
.env.*
!.env.example
*.pfx
*.snk
