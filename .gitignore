# Entradas proprietárias fornecidas externamente; não distribuir no repositório.
/app.apk
/packages/neonews/*.apk
/packages/webview/*.apk
/packages/tts/*.apk

# Runtime e estado gerados localmente.
/runtime/
/logs/*
!/logs/.gitkeep
/reports/*
